{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Backend.js",
      "Package.json",
      "Dockerfile",
      "**/.env*"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "reverse-coding-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "reverse-coding-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}